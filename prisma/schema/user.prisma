model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     Role 

  agentProfile AgentProfile?

  verifiedAgents AgentProfile[] @relation("AgentVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations required by auth adapters
  accounts Account[]
  sessions Session[]
}

model AgentProfile {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  phone     String @unique

  agencyName    String
  agencyAddress String

  licenseNumber   String @unique
  licenseState    String
  licenseCopyPath String
  idProofPath     String

  profilePhotoPath String?

  bio             String
  specializations String[]
  yearsExperience Int

  backgroundCheckConsent Boolean
  codeOfConductAccepted  Boolean
  termsAccepted          Boolean

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  verifiedById String?
  verifiedBy   User?   @relation("AgentVerifiedBy", fields: [verifiedById], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
